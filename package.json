{
  "name": "ngx-triple-ssp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build ng-triple-exemple",
    "build:lib": "ng build ngx-triple-ssp",
    "publish:lib": "cd dist/ngx-triple-ssp && npm publish",
    "watch": "ng build --watch --configuration development",
    "build:wba": "ng build --configuration production --aot --base-href / --stats-json",
    "build:analyzer": "npx webpack-bundle-analyzer dist/opcoes/stats.json",
    "test": "ng test",
    "test:docker": "ng test --watch=false --sourceMap=false --codeCoverage=true --browsers ChromeHeadless",
    "test:common": "ng test --browsers Chrome,Firefox",
    "test:ci": "ng test --watch=true --reporters junit --browsers ChromeHeadless",
    "test:cov": "ng test --watch=true --sourceMap=true --codeCoverage=true --browsers ChromeHeadless",
    "lint": "ng lint",
    "eslint:init": "eslint --init",
    "eslint": "eslint . --ext .ts",
    "eslint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write ."
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "bootstrap": "^5",
    "jquery": "^3.6.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.0.0",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "karma-junit-reporter": "^2.0.1",
    "ng-packagr": "^18.2.1",
    "prettier": "^3.0.0",
    "puppeteer": "^22.0.0",
    "typescript": "~5.5.0",
    "webpack-bundle-analyzer": "^4.10.0"
  }
}
